# Template for .ssh/config -- copy to .ssh/config and fill in the placeholders
# before running post-install.sh:
#
#   cp .ssh/config.example .ssh/config
#   $EDITOR .ssh/config
#
# .ssh/config itself is gitignored (never commit it) since it holds a real
# internal IP and username. Host aliases below must stay named exactly as-is --
# .config/systemd/user/iclinic-tunnel.service invokes `autossh -N iclinic-tunnel`,
# which resolves through the "iclinic-tunnel" Host block.

Host iclinic-tunnel
	User <SSH_USER>
	HostName <TUNNEL_HOST_IP>
	AddressFamily inet
	LogLevel QUIET
	IdentityFile ~/.ssh/<TUNNEL_IDENTITY_FILE>
	IdentitiesOnly yes
	ServerAliveInterval 30
	ServerAliveCountMax 3
	DynamicForward 8888
	LocalForward 8001 localhost:8001 # iclinic-api
	LocalForward 8002 localhost:8002 # iclinic-localstack
	LocalForward 8004 localhost:8004 # iclinic-app
	LocalForward 3006 localhost:3006 # iclinic-webapp
	LocalForward 3012 localhost:3012 # iclinic-frontend
	LocalForward 8009 localhost:8009 # iclinic-pep-api
	LocalForward 4242 localhost:4242 # iclinic-4242

Host iclinic
	User <SSH_USER>
	HostName <TUNNEL_HOST_IP>
	AddressFamily inet
	LogLevel QUIET
	IdentityFile ~/.ssh/<TUNNEL_IDENTITY_FILE>
	IdentitiesOnly yes
	ServerAliveInterval 30
	ServerAliveCountMax 3
