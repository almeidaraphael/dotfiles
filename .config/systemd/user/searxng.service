[Unit]
Description=SearxNG - local search backend for the Quickshell assistant
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose -f %h/services/searxng/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f %h/services/searxng/docker-compose.yml down

[Install]
WantedBy=graphical-session.target
